<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jpg</groupId>
    <artifactId>jboss-prometheus-grafana</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>portal-web</artifactId>
  <packaging>war</packaging>
  <name>portal-web</name>
  <description>
    Stand-in clinical portal: JSF 2.3 + PrimeFaces 13 on WildFly 26.1.
    Login -> electronic discharge form -> discharge list. Generic, no real
    workplace content.
  </description>

  <dependencies>
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-web-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.primefaces</groupId>
      <artifactId>primefaces</artifactId>
    </dependency>

    <dependency>
      <groupId>io.github.jpg</groupId>
      <artifactId>metrics-api</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Exactly one backend, chosen by profile (Spike A). See <profiles> below. -->

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- Default. Maven disables activeByDefault profiles automatically when the
         prometheus-client profile is activated with -Dbackend=prometheus-client. -->
    <profile>
      <id>micrometer</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <dependencies>
        <dependency>
          <groupId>io.github.jpg</groupId>
          <artifactId>metrics-micrometer</artifactId>
          <version>${project.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>prometheus-client</id>
      <activation>
        <property><name>backend</name><value>prometheus-client</value></property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>io.github.jpg</groupId>
          <artifactId>metrics-prometheus</artifactId>
          <version>${project.version}</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

  <build>
    <finalName>portal-web</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
